# PyDOS Makefile for macOS (debug build)
# Usage: make -f Makefile.mac [all|compiler|runtime|release|clean]
#
# compiler: builds bin/pydos (native macOS binary for debugging)
# runtime:  compiles runtime .c files (validation only, no link)

CXX      = clang++
CC       = clang
CXXFLAGS = -std=c++98 -g -O0 -Wall -Werror
CFLAGS   = -std=c89 -g -O0 -Wall -Werror -include compat/dos.h -Icompat
DEPFLAGS = -MMD -MP

OBJDIR = build
BINDIR = bin
RELEASE_TARGET ?= all

# ---- Compiler sources ----
COMP_SRCS = compiler/main.cpp \
            compiler/execmode.cpp \
            compiler/pbc.cpp \
            compiler/pbcop.cpp \
            compiler/pbcmod.cpp \
            compiler/pbcarc.cpp \
            compiler/pbclwr.cpp \
            compiler/lexer.cpp \
            compiler/ast.cpp \
            compiler/parser.cpp \
            compiler/types.cpp \
            compiler/sema.cpp \
            compiler/mono.cpp \
            compiler/ir.cpp \
            compiler/iropt.cpp \
            compiler/codegen.cpp \
            compiler/cg8086.cpp \
            compiler/cg386.cpp \
            compiler/regalloc.cpp \
            compiler/error.cpp \
            compiler/pir.cpp \
            compiler/pirbld.cpp \
            compiler/pirprt.cpp \
            compiler/pirlwr.cpp \
            compiler/pirdom.cpp \
            compiler/pirutil.cpp \
            compiler/pirhyg.cpp \
            compiler/piropt.cpp \
            compiler/pirtyp.cpp \
            compiler/piresc.cpp \
            compiler/pirspc.cpp \
            compiler/modpath.cpp \
            compiler/astdce.cpp \
            compiler/modscan.cpp \
            compiler/stdscan.cpp \
            compiler/pirsrlz.cpp \
            compiler/pirmrg.cpp \
            compiler/stdbld.cpp

COMP_OBJS = $(patsubst compiler/%.cpp,$(OBJDIR)/%.o,$(COMP_SRCS))
COMP_DEPS = $(COMP_OBJS:.o=.d)

# ---- Runtime sources ----
RT_SRCS = runtime/pdos_obj.c \
          runtime/pdos_ops.c \
          runtime/pdos_mon.c \
          runtime/pdos_mem.c \
          runtime/pdos_gc.c \
          runtime/pdos_io.c \
          runtime/pdos_tui.c \
          runtime/pdos_str.c \
          runtime/pdos_int.c \
          runtime/pdos_blt.c \
          runtime/pdos_exc.c \
          runtime/pdos_vtb.c \
          runtime/pdos_lst.c \
          runtime/pdos_dic.c \
          runtime/pdos_itn.c \
          runtime/pdos_gen.c \
          runtime/pdos_rt.c \
          runtime/pdos_sjn.c \
          runtime/pdos_arn.c \
          runtime/pdos_cll.c \
          runtime/pdos_asn.c \
          runtime/pdos_exg.c \
          runtime/pdos_fzs.c \
          runtime/pdos_cpx.c \
          runtime/pdos_bya.c \
          runtime/pdos_byt.c \
          runtime/pdos_rng.c \
          runtime/pdos_cod.c \
          runtime/pdos_vm.c

RT_OBJS = $(patsubst runtime/%.c,$(OBJDIR)/%.o,$(RT_SRCS))
RT_DEPS = $(RT_OBJS:.o=.d)

TESTOBJDIR = build/test

# ---- Test sources ----
TEST_SRCS = rttests/main.c \
            rttests/t_obj.c \
            rttests/t_mem.c \
            rttests/t_str.c \
            rttests/t_gc.c \
            rttests/t_int.c \
            rttests/t_lst.c \
            rttests/t_exc.c \
            rttests/t_io.c \
            rttests/t_gen.c \
            rttests/t_rt.c \
            rttests/t_vtb.c \
            rttests/t_itn.c \
            rttests/t_dic.c \
            rttests/t_blt.c \
            rttests/t_e2e.c \
            rttests/t_gcs.c \
            rttests/t_func.c \
            rttests/t_sjn.c \
            rttests/t_arn.c \
            rttests/t_set.c \
            rttests/t_cll.c \
            rttests/t_asn.c \
            rttests/t_unp.c \
            rttests/t_fzs.c \
            rttests/t_cpx.c \
            rttests/t_bya.c \
            rttests/t_excg.c \
            rttests/t_vm.c \
            rttests/t_tui.c

TEST_OBJS = $(patsubst rttests/%.c,$(TESTOBJDIR)/%.o,$(TEST_SRCS))
TEST_DEPS = $(TEST_OBJS:.o=.d)

# ---- Targets ----
all: compiler runtime

compiler: $(BINDIR)/pydos $(BINDIR)/stdlib.idx

runtime: $(RT_OBJS)
	@echo "=== Runtime: all files compiled OK (validation only) ==="

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(BINDIR):
	mkdir -p $(BINDIR)

$(OBJDIR)/%.o: compiler/%.cpp | $(OBJDIR)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c -o $@ $<

$(OBJDIR)/%.o: runtime/%.c | $(OBJDIR)
	$(CC) $(CFLAGS) $(DEPFLAGS) -c -o $@ $<

$(BINDIR)/pydos: $(COMP_OBJS) | $(BINDIR)
	$(CXX) $(CXXFLAGS) -o $@ $(COMP_OBJS)

$(TESTOBJDIR):
	mkdir -p $(TESTOBJDIR)

$(TESTOBJDIR)/%.o: rttests/%.c | $(TESTOBJDIR)
	$(CC) $(CFLAGS) $(DEPFLAGS) -c -o $@ $<

$(BINDIR)/rttest: $(TEST_OBJS) $(RT_OBJS) | $(BINDIR)
	$(CC) $(CFLAGS) -o $@ $(TEST_OBJS) $(RT_OBJS) -lm

$(BINDIR)/test-vm-runtime: rttests/vm_main.c rttests/t_vm.c $(RT_OBJS) | $(BINDIR)
	$(CC) $(CFLAGS) -o $@ rttests/vm_main.c rttests/t_vm.c $(RT_OBJS) -lm

test: $(BINDIR)/rttest
	./$(BINDIR)/rttest

test-vm-runtime: $(BINDIR)/test-vm-runtime
	./$(BINDIR)/test-vm-runtime

test-compiler-modes: compiler
	bash tests/test_compiler_modes.sh

$(BINDIR)/test-pbc: compiler/tests/t_pbc.cpp compiler/pbc.cpp compiler/pbc.h | $(BINDIR)
	$(CXX) $(CXXFLAGS) -Icompiler -o $@ compiler/tests/t_pbc.cpp compiler/pbc.cpp

test-pbc: $(BINDIR)/test-pbc
	./$(BINDIR)/test-pbc

$(BINDIR)/test-pbcop: compiler/tests/t_pbcop.cpp compiler/pbcop.cpp compiler/pbcop.h compiler/pbc.h | $(BINDIR)
	$(CXX) $(CXXFLAGS) -Icompiler -o $@ compiler/tests/t_pbcop.cpp compiler/pbcop.cpp

test-pbcop: $(BINDIR)/test-pbcop
	./$(BINDIR)/test-pbcop

$(BINDIR)/test-pbcmod: compiler/tests/t_pbcmod.cpp compiler/pbcmod.cpp compiler/pbcmod.h compiler/pbcop.cpp compiler/pbcop.h compiler/pbc.cpp compiler/pbc.h | $(BINDIR)
	$(CXX) $(CXXFLAGS) -Icompiler -o $@ compiler/tests/t_pbcmod.cpp compiler/pbcmod.cpp compiler/pbcop.cpp compiler/pbc.cpp

test-pbcmod: $(BINDIR)/test-pbcmod
	./$(BINDIR)/test-pbcmod

$(BINDIR)/test-pbcarchive: compiler/tests/t_pbcarc.cpp compiler/pbcarc.cpp compiler/pbcarc.h compiler/pbcmod.cpp compiler/pbcmod.h compiler/pbcop.cpp compiler/pbcop.h compiler/pbc.cpp compiler/pbc.h | $(BINDIR)
	$(CXX) $(CXXFLAGS) -Icompiler -o $@ compiler/tests/t_pbcarc.cpp compiler/pbcarc.cpp compiler/pbcmod.cpp compiler/pbcop.cpp compiler/pbc.cpp

test-pbcarchive: $(BINDIR)/test-pbcarchive
	./$(BINDIR)/test-pbcarchive

$(BINDIR)/test-pbclwr: compiler/tests/t_pbclwr.cpp compiler/pbclwr.cpp compiler/pbclwr.h compiler/pir.cpp compiler/pir.h compiler/pbcmod.cpp compiler/pbcmod.h compiler/pbcop.cpp compiler/pbcop.h compiler/pbc.cpp compiler/pbc.h | $(BINDIR)
	$(CXX) $(CXXFLAGS) -Icompiler -o $@ compiler/tests/t_pbclwr.cpp compiler/pbclwr.cpp compiler/pir.cpp compiler/pbcmod.cpp compiler/pbcop.cpp compiler/pbc.cpp

test-pbclwr: $(BINDIR)/test-pbclwr
	./$(BINDIR)/test-pbclwr

$(BINDIR)/test-modpath: compiler/tests/t_modpth.cpp compiler/modpath.cpp compiler/modpath.h | $(BINDIR)
	$(CXX) $(CXXFLAGS) -Icompiler -o $@ compiler/tests/t_modpth.cpp compiler/modpath.cpp

test-modpath: $(BINDIR)/test-modpath
	./$(BINDIR)/test-modpath

$(BINDIR)/test-astdce: compiler/tests/t_astdce.cpp compiler/astdce.cpp compiler/astdce.h compiler/ast.cpp compiler/ast.h | $(BINDIR)
	$(CXX) $(CXXFLAGS) -Icompiler -o $@ compiler/tests/t_astdce.cpp compiler/astdce.cpp compiler/ast.cpp

test-astdce: $(BINDIR)/test-astdce
	./$(BINDIR)/test-astdce

# ---- Release packaging ----
print-compiler-sources:
	@for source in $(COMP_SRCS); do printf '%s\n' $$source; done

print-runtime-sources:
	@for source in $(RT_SRCS); do printf '%s\n' $$source; done

release: compiler
	CCACHE_DISABLE=1 scripts/build_release.sh $(RELEASE_TARGET)

# ---- Stdlibgen tool ----
STDGEN_SRCS = compiler/stdgen.cpp
STDGEN_OBJS = $(OBJDIR)/stdgen.o

STUB_FILES = stdlib/builtins/funcs.py \
             stdlib/builtins/dosio.py \
             stdlib/builtins/dostui.py \
             stdlib/builtins/str.py \
             stdlib/builtins/list.py \
             stdlib/builtins/dict.py \
             stdlib/builtins/set.py \
             stdlib/builtins/int.py \
             stdlib/builtins/float.py \
             stdlib/builtins/tuple.py \
             stdlib/builtins/frozenst.py \
             stdlib/builtins/complex.py \
             stdlib/builtins/bytearr.py \
             stdlib/builtins/bytes.py \
             stdlib/builtins/range.py \
             stdlib/builtins/pyfncs.py \
             stdlib/_interna.py

# Legacy stdgen (kept temporarily for compatibility)
$(OBJDIR)/stdgen.o: compiler/stdgen.cpp compiler/stdscan.h | $(OBJDIR)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(BINDIR)/stdgen: $(STDGEN_OBJS) | $(BINDIR)
	$(CXX) $(CXXFLAGS) -o $@ $(STDGEN_OBJS)

stdgen: $(BINDIR)/stdgen

-include $(COMP_DEPS) $(RT_DEPS) $(TEST_DEPS)

$(BINDIR)/stdlib.idx: $(BINDIR)/pydos $(STUB_FILES)
	./$(BINDIR)/pydos --build-stdlib stdlib -o $(BINDIR)/stdlib.idx

clean:
	rm -rf $(OBJDIR)
	rm -rf $(TESTOBJDIR)
	rm -f $(BINDIR)/pydos
	rm -f $(BINDIR)/rttest
	rm -f $(BINDIR)/test-vm-runtime
	rm -f $(BINDIR)/test-pbcarchive
	rm -f $(BINDIR)/test-pbclwr
	rm -f $(BINDIR)/test-modpath
	rm -f $(BINDIR)/stdgen
	rm -f $(BINDIR)/stdlib.idx

.PHONY: all compiler runtime test test-vm-runtime test-pbcarchive test-pbclwr test-modpath release print-compiler-sources print-runtime-sources clean stdgen
